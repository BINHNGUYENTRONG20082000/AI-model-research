<tr><td>Tỉ lệ nội dung không an toàn (thấp hơn tốt hơn)</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>Tỉ lệ đúng định dạng đầu ra</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>Độ nhất quán khi lặp lại</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
</table>
<h3>3. Đánh giá theo con người</h3>
<table>
<tr><th>Tiêu chí</th><th>Cỡ mẫu</th><th>Điểm TB</th><th>Ngưỡng</th><th>Đạt?</th></tr>
