<tr><th>Chỉ số</th><th>Baseline</th><th>Model</th><th>Ngưỡng tối thiểu</th><th>Đạt?</th></tr>
<tr><td>Accuracy</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>Precision</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>Recall</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>F1</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>ROC-AUC / PR-AUC</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
</table>
<h3>2A. Chỉ số kỹ thuật — [ML] Hồi quy</h3>
<table>
<tr><th>Chỉ số</th><th>Baseline</th><th>Model</th><th>Ngưỡng</th><th>Đạt?</th></tr>
<tr><td>MAE</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>RMSE</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
<tr><td>R²</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
</table>
<h3>2B. Chỉ số chất lượng — [LLM]</h3>
